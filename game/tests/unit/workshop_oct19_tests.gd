extends SceneTree
const Serializer = preload("res://scripts/core/maps/map_serializer.gd")
const Loader = preload("res://scripts/core/maps/map_loader.gd")
const Factory = preload("res://scripts/core/rules/match_factory.gd")
var failures := 0
var checks := 0
func check(value: bool, label: String) -> void:
	checks += 1
	if not value:
		failures += 1
		push_error(label)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	if not FileAccess.file_exists("res://scripts/core/workshop/workshop_document.gd"):
		check(false,"W01 Workshop document must exist")
		quit(1)
		return
	var doc = load("res://scripts/core/workshop/workshop_document.gd").new()
	var store = load("res://scripts/core/workshop/workshop_store.gd").new()
	doc.new_document()
	check(doc.snapshot().size == Vector3i(32,12,32) and Factory.from_definition(doc.snapshot(),2) != null,"W01 default arena playable")
	var shipped = Loader.load_from_file("res://maps/twin_forts.toml")
	var shipped_text: String = Serializer.to_toml(shipped).text
	doc.replace_definition(shipped)
	doc.update_entry("boxes",0,{"name":"Changed"})
	check(Serializer.to_toml(Loader.load_from_file("res://maps/twin_forts.toml")).text == shipped_text,"W02 shipped definition remains immutable")
	doc.new_document()
	check(doc.set_metadata({"id":"local_arena_1"}).ok,"W03 ID accepted")
	for invalid in ["", "Bad", "bad id"]: check(not doc.set_metadata({"id":invalid}).ok,"W03 invalid ID rejected")
	check(doc.set_metadata({"name":"Łódź #1", "theme":"stone"}).ok,"W04 Unicode metadata")
	check(not doc.set_metadata({"name":"a\nb"}).ok and not doc.set_metadata({"theme":"x".repeat(65)}).ok,"W04 invalid text atomic")
	var box := {"position":[5,1,5],"size":[3,3,3],"material":"dirt","name":"Cover"}
	check(doc.add_entry("boxes",box).ok and doc.selection.index == 1,"W06 add selects box")
	check(doc.update_entry("boxes",1,{"position":[6,1,5],"size":[2,2,2]}).ok,"W07 box transform")
	var before := JSON.stringify(Serializer.to_dictionary(doc.snapshot()))
	check(not doc.update_entry("boxes",1,{"position":[-1,1,1],"size":[0,2,2]}).ok and JSON.stringify(Serializer.to_dictionary(doc.snapshot())) == before,"W07 invalid transform atomic")
	for material in ["dirt","stone","metal","air"]:
		check(doc.update_entry("boxes",1,{"material":material}).ok,"W08 material %s" % material)
		var built: Dictionary = doc.validate()
		check(built.ok and built.arena.world.get_material_id(Vector3i(6,1,5)) == ["air","dirt","stone","metal"].find(material),"W08 built material %s" % material)
	check(doc.update_entry("boxes",1,{"material":"stone","health":77}).ok,"W09 health override")
	check(doc.validate().arena.world.get_health(Vector3i(6,1,5)) == 77,"W09 health built")
	check(doc.update_entry("boxes",1,{"health":null}).ok and not doc.snapshot().boxes[1].has("health"),"W09 disable override")
	check(doc.validate().arena.world.get_health(Vector3i(6,1,5)) == 180,"W09 default health")
	check(not doc.update_entry("boxes",1,{"health":0}).ok,"W09 solid zero health rejected")
	check(doc.update_entry("boxes",1,{"name":"Named cover"}).ok and Serializer.to_toml(doc.snapshot()).text.contains("Named cover"),"W10 label exported")
	check(doc.duplicate_entry("boxes",1).ok,"W11 duplicate box")
	doc.update_entry("boxes",2,{"position":[9,1,5]})
	check(doc.snapshot().boxes[1].position == [6,1,5],"W11 duplicate isolation")
	check(doc.remove_entry("boxes",2).ok and doc.undo() and doc.snapshot().boxes.size() == 3,"W12 delete undo")
	doc.remove_entry("boxes",2)
	doc.add_entry("boxes",{"position":[6,1,5],"size":[2,2,2],"material":"metal"})
	check(doc.validate().arena.world.get_material_id(Vector3i(6,1,5)) == 3,"W13 overlap before reorder")
	check(doc.move_entry("boxes",2,-1).ok and doc.validate().arena.world.get_material_id(Vector3i(6,1,5)) == 2,"W13 reorder changes built world")
	check(doc.add_entry("carves",{"position":[6,1,5],"shape":"sphere","radius":1}).ok and doc.validate().arena.world.get_material_id(Vector3i(6,1,5)) == 0,"W14 carve built")
	check(doc.update_entry("carves",0,{"position":[7,2,5],"radius":2}).ok,"W15 carve edit")
	for patch in [{"radius":0},{"radius":257},{"position":[9999,9999,9999]}]: check(not doc.update_entry("carves",0,patch).ok,"W15 invalid carve rejected")
	check(doc.duplicate_entry("carves",0).ok,"W16 duplicate carve")
	doc.update_entry("carves",1,{"position":[8,2,5]})
	check(doc.snapshot().carves[0].position == [7,2,5] and doc.remove_entry("carves",1).ok and doc.undo(),"W16 independent carve delete undo")
	doc.new_document()
	check(doc.add_entry("spawns",{"position":[10,1,10],"team":1,"slot":1,"yaw":0}).ok,"W17 add blue spawn")
	check(doc.add_entry("spawns",{"position":[20,1,20],"team":2,"slot":1,"yaw":90}).ok,"W17 add red spawn")
	check(doc.update_entry("spawns",3,{"position":[22,1,22],"yaw":180}).ok,"W18 position yaw")
	check(not doc.update_entry("spawns",3,{"yaw":INF}).ok and not doc.update_entry("spawns",3,{"position":[1.5,1,1]}).ok,"W18 invalid numeric input")
	check(doc.update_entry("spawns",3,{"team":1,"slot":1}).ok and not doc.validate().ok,"W19 duplicate slot visible in validation")
	check(not doc.update_entry("spawns",3,{"team":3}).ok and not doc.update_entry("spawns",3,{"slot":-1}).ok,"W19 invalid team/slot")
	doc.update_entry("spawns",3,{"team":2})
	check(doc.duplicate_entry("spawns",3).ok and not doc.validate().ok,"W20 spawn duplicate collision")
	doc.update_entry("spawns",4,{"position":[24,1,24],"slot":2})
	check(doc.snapshot().spawns[3].position == [22,1,22],"W20 spawn copy isolation")
	doc.remove_entry("spawns",4)
	check(doc.undo() and doc.snapshot().spawns[4].yaw == 180,"W20 spawn delete undo")
	doc.new_document()
	var initial: String = JSON.stringify(Serializer.to_dictionary(doc.snapshot()))
	doc.set_metadata({"name":"History"})
	doc.add_entry("boxes",box)
	doc.update_entry("boxes",1,{"name":"Updated"})
	doc.move_entry("boxes",1,-1)
	doc.remove_entry("boxes",0)
	for step in 5: check(doc.undo(),"W21 undo transaction %d" % step)
	check(JSON.stringify(Serializer.to_dictionary(doc.snapshot())) == initial,"W21 exact undo snapshot")
	check(doc.redo(),"W22 redo transaction")
	doc.undo()
	doc.add_entry("boxes",box)
	check(not doc.can_redo(),"W22 branch discarded")
	doc.new_document()
	for number in 40: doc.set_metadata({"name":"Name %s" % number})
	check(doc.history_summary().undo == 32,"W23 bounded history")
	var summary: Dictionary = doc.history_summary()
	doc.set_metadata({"name":"Name 39"})
	doc.set_metadata({"id":"!"})
	check(doc.history_summary() == summary,"W23 noop/error excluded")
	doc.mark_saved("/private/tmp/test.toml")
	doc.set_metadata({"theme":"metal"})
	check(doc.is_dirty() and doc.undo() and not doc.is_dirty() and doc.redo() and doc.is_dirty(),"W24 dirty matches saved content")
	doc.new_document()
	var tmp := "/private/tmp" if OS.get_name() == "macOS" else "/tmp"
	var folder := tmp.path_join("terrablast-workshop-%d" % OS.get_process_id())
	DirAccess.make_dir_recursive_absolute(folder)
	var path := folder.path_join("arena.toml")
	check(store.save_document(path,doc.snapshot()).ok,"W26 TOML saved")
	var loaded: Dictionary = store.load_document(path)
	check(loaded.ok and Serializer.to_dictionary(loaded.definition) == Serializer.to_dictionary(doc.snapshot()),"W25 import roundtrip")
	doc.set_metadata({"name":"Second save"})
	check(store.save_document(path,doc.snapshot()).ok and store.load_document(path).definition.display_name == "Second save","W27 save same path")
	var stable := FileAccess.get_file_as_string(path)
	DirAccess.make_dir_absolute(path + ".tmp")
	check(not store.save_document(path,doc.snapshot()).ok and FileAccess.get_file_as_string(path) == stable,"W28 failure preserves previous target")
	DirAccess.remove_absolute(path + ".tmp")
	check(store.save_document(path,doc.snapshot()).ok and not FileAccess.file_exists(path + ".tmp"),"W28 atomic temp removed")
	check(not store.save_document("res://maps/twin_forts.toml",doc.snapshot()).ok,"W29 resources protected")
	check(Serializer.to_toml(Loader.load_from_file("res://maps/twin_forts.toml")).text == shipped_text,"W29 shipped bytes preserved")
	check(doc.set_metadata({"size":Vector3i(8,6,8)}).ok and doc.snapshot().spawns.size() == 2 and not doc.validate().ok,"W05 resize preserves entries and reports bounds")
	check(not doc.set_metadata({"size":Vector3i(257,128,256)}).ok,"W05 dimensions limited")
	check(not doc.validate().errors.is_empty(),"W31 validation report")
	doc.new_document()
	doc.update_entry("spawns",0,{"position":[3,0,3]})
	check(not doc.validate().ok,"W32 blocked spawn")
	doc.undo()
	doc.remove_entry("boxes",0)
	check(not doc.validate().ok,"W32 unsupported spawn")
	doc.undo()
	doc.add_entry("spawns",{"position":[10,1,10],"team":1,"slot":1,"yaw":0})
	doc.add_entry("spawns",{"position":[20,1,20],"team":2,"slot":1,"yaw":0})
	check(doc.validate().supported_counts.has(2) and doc.validate().supported_counts.has(4),"W33 supported player counts")
	var revision: int = doc.validate().revision
	doc.remove_entry("spawns",3)
	check(doc.validate().revision > revision and not doc.validate().supported_counts.has(4),"W34 validation revision invalidated")
	var empty_path := folder.path_join("empty.toml")
	FileAccess.open(empty_path,FileAccess.WRITE).close()
	check(not store.load_document(empty_path).ok,"W35 empty import rejected")
	var big_path := folder.path_join("large.toml")
	var big := FileAccess.open(big_path,FileAccess.WRITE)
	big.store_string("x".repeat(1048577))
	big.close()
	check(not store.load_document(big_path).ok,"W35 oversized import rejected")
	for name in ["arena.toml","empty.toml","large.toml"]: DirAccess.remove_absolute(folder.path_join(name))
	DirAccess.remove_absolute(folder)
	print("Workshop unit: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
