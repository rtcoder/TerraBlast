extends SceneTree
const Replay = preload("res://scripts/core/replay/match_replay.gd")
const Factory = preload("res://scripts/core/rules/match_factory.gd")
const Archive = preload("res://scripts/core/replay/replay_archive.gd")
var failures := 0
var checks := 0
func check(value: bool, message: String) -> void:
	checks += 1
	if not value: failures += 1; push_error(message)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	if not FileAccess.file_exists("res://scripts/core/replay/replay_notebook.gd"):
		check(false,"S01 replay notebook must exist")
		quit(1)
		return
	var Notes = load("res://scripts/core/replay/replay_notebook.gd")
	var Clip = load("res://scripts/core/replay/replay_clip_job.gd")
	var Diff = load("res://scripts/core/replay/replay_diff.gd")
	var runner = Factory.from_definition(load("res://scripts/core/workshop/workshop_document.gd").new().snapshot(),2)
	var rec := Replay.new()
	rec.capture(runner)
	for index in 6: rec.tick(runner,0.1)
	var fingerprint: String = Notes.fingerprint(rec)
	var n = Notes.new()
	check(n.bind(fingerprint,6).ok and n.encode().version == 1 and n.encode().fingerprint == fingerprint,"S01 versioned fingerprint sidecar")
	var first: Dictionary = n.add(3,"Środek","Zażółć\nGęślą","highlight")
	check(first.ok and first.id.length() == 32 and n.add(0,"Start","","note").ok and n.add(6,"EOF","","hit").ok,"S02 bookmark endpoints unique IDs")
	check(not n.add(-1,"Bad","","note").ok and not n.add(7,"Bad","","note").ok and not n.add(0,"x".repeat(81),"","note").ok,"S02 index title limits")
	var encoded: Dictionary = n.encode()
	check(n.edit(first.id,{"title":"Edited","body":"Opis"}).ok and n.list()[1].id == first.id and n.list()[1].index == 3,"S03 edit preserves identity")
	check(not n.edit(first.id,{"index":2}).ok and n.list()[1].index == 3,"S03 edit atomic")
	check(n.edit(first.id,{"body":"Zażółć\nGęślą"}).ok and not n.edit(first.id,{"body":"a\u0001b"}).ok and not n.edit(first.id,{"body":"x".repeat(2001)}).ok,"S05 body Unicode controls limits")
	check(n.list("","highlight").size() == 1 and not n.add(1,"Bad","","bad").ok,"S06 categories filter")
	check(n.list("GĘŚLĄ").size() == 1 and n.list().size() == 3,"S07 case-insensitive search")
	var imported = Notes.new()
	imported.bind(fingerprint,6)
	encoded.rows.reverse()
	check(imported.decode(encoded,fingerprint,6).ok and imported.list()[0].index == 0 and imported.list()[2].index == 6,"S08 stable index ordering")
	check(not imported.decode(encoded,"a".repeat(64),6).ok and imported.list().size() == 3,"S09 stale notebook rejected")
	check(n.remove(first.id).ok and n.list().size() == 2 and not n.remove(first.id).ok,"S04 removal exact ID")
	check(n.merge(encoded).ok and n.list().size() == 3 and n.merge(encoded).ok and n.list().size() == 3,"S12 merge deduplicates")
	var conflict := encoded.duplicate(true)
	conflict.rows[0].title = "Conflict"
	check(not n.merge(conflict).ok and n.list().size() == 3,"S12 conflicting merge atomic")
	var fractional := encoded.duplicate(true)
	fractional.rows[0].index = 1.2
	check(not imported.decode(fractional,fingerprint,6).ok,"S02 JSON fractional index rejected")
	var tmp := "/private/tmp" if OS.get_name() == "macOS" else "/tmp"
	var path := tmp.path_join("terrablast-studio-notes-%s.json" % OS.get_process_id())
	check(n.save_to(path).ok and not n.save_to(path,false).ok,"S10 S11 atomic write overwrite protection")
	check(imported.load_from(path).ok and imported.list().size() == 3,"S10 bounded notebook load")
	var bad := FileAccess.open(path,FileAccess.WRITE)
	bad.store_string("bad json")
	bad.close()
	check(not imported.load_from(path).ok and imported.list().size() == 3,"S10 corrupt load preserves notes")

	var wide = Notes.new()
	wide.bind(fingerprint,6)
	for index in 200: check(wide.add(index % 7,"😀".repeat(80),"😀".repeat(2000),"note").ok,"S10 full Unicode note %d" % index)
	check(wide.save_to(path).ok,"S10 full 200-row Unicode notebook saves")
	var reopened = Notes.new()
	reopened.bind(fingerprint,6)
	check(reopened.load_from(path).ok and reopened.list().size() == 200,"S10 full Unicode notebook reopens own saved output")
	check(not wide.add(0,"Overflow","","note").ok,"S12 note count limit")
	DirAccess.remove_absolute(path)
	var original_data: String = JSON.stringify(rec.data,"",true,true)
	var job = Clip.new()
	check(not job.begin(rec,2,2) and not job.begin(rec,6,7) and job.begin(rec,2,5),"S16 reject empty EOF out-of-range clips")
	var progress: Dictionary = job.step(1)
	check(job.index == 1 and not job.finished and progress.phase == "prefix","S19 prefix replay budget")
	job.step(1)
	check(job.index == 2 and not job.finished,"S19 second bounded frame")
	while not job.finished: job.step(1)
	check(job.error.is_empty() and job.result_recorder.data.actions.size() == 3,"S17 original action subrange")
	var expected = rec.initial_runner()
	for index in 5: Replay.execute_action(expected,rec.data.actions[index])
	check(Replay.state_hash(job.result_runner) == Replay.state_hash(expected) and JSON.stringify(rec.data,"",true,true) == original_data,"S18 end hash source immutable")
	var start = rec.initial_runner()
	for index in 2: Replay.execute_action(start,rec.data.actions[index])
	check(Replay.state_hash(job.result_recorder.initial_runner()) == Replay.state_hash(start),"S17 clip captures exact start")
	var clip_archive: Dictionary = Archive.encode(job.result_recorder,job.result_runner)
	check(clip_archive.ok and Archive.decode(clip_archive.payload).ok,"S21 verified clip archive")
	var moved = job.notebook_for_clip(n)
	check(moved.list().size() == 1 and moved.list()[0].index == 1 and moved.encode().fingerprint != fingerprint,"S23 notes remapped clip fingerprint")
	job.begin(rec,1,4)
	job.step(1)
	job.cancel()
	check(job.finished and job.error == "cancelled" and not job.step(99).ok and job.result_recorder == null,"S20 clip cancel no result")

	# Version 1 archives use the same replay recording with a full-precision final hash.
	var legacy_clip := {"version":1,"recording":Archive.decode(clip_archive.payload).recorder.data,"expected_hash":Replay.state_hash(expected),"hash_precision":"full"}
	check(Archive.decode(legacy_clip).ok,"S21 legacy and exact clip decode")
	var dense := Replay.new()
	dense.capture(start)
	for index in 5000: dense.record_action({"type":"tick","delta":0.0})
	check(job.begin(dense,4500,5000) and job.step(99999).work == 4096 and job.index == 4096,"S19 hard per-step action budget")
	job.cancel()
	var invalid_binding = Notes.new()
	check(not invalid_binding.bind(fingerprint,1.2).ok,"S02 fractional action count binding rejected")
	var copy := Replay.new()
	copy.data = rec.data.duplicate(true)
	var same: Dictionary = Diff.compare(rec,copy,2)
	check(same.ok and same.terrain.count == 0 and same.players.is_empty() and same.configuration.initial_equal,"S25 identical private comparison")
	copy.data.state.players[0].health -= 1
	copy.data.state.players[0].position[0] += 1
	copy.data.weapons[1].max_uses_per_match = -1
	for ammo in copy.data.state.inventory.values(): ammo[2] = -1
	copy.data.state.statistics.blue_1.shots += 2
	copy.data.terrain[0] = 2
	copy.data.health[1] -= 1
	copy.data.actions[2].delta = 0.2
	var report: Dictionary = Diff.compare(rec,copy,1)
	check(report.ok and report.players.size() == 1 and report.players[0].id == "blue_1","S25 player ID HP position diff")
	check(report.inventory.size() > 0 and report.inventory[0].right == -1 and report.inventory[0].delta == null,"S26 unlimited inventory diff")
	check(report.statistics.size() > 0,"S27 full statistics delta")
	check(report.terrain.count == 2 and report.terrain.details.size() == 1 and report.terrain.truncated,"S28 full terrain count bounded details")
	check(report.terrain.material_changes == 1 and report.terrain.health_changes == 1,"S29 distinguish voxel health material")
	check(report.actions.first_difference == 2,"S30 first canonical action mismatch")
	check(not report.configuration.initial_equal and report.configuration.rules_equal and not report.configuration.weapons_equal,"S31 honest initial config mismatch")
	check(JSON.stringify(rec.data,"",true,true) == original_data,"S27 comparison source immutable")
	check(Diff.export(path,report,false).ok and not Diff.export(path,report,false).ok,"S33 report export protect overwrite")
	DirAccess.remove_absolute(path)
	print("Replay studio unit: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
