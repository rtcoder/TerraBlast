extends SceneTree
var failures := 0
func check(value: bool, message: String) -> void:
	if not value:
		failures += 1
		push_error(message)
func _initialize(): call_deferred("run")
func run():
	for path in ["client/session/local_match_profiles.gd", "client/session/local_autosave.gd", "client/session/match_series.gd", "core/training/training_session.gd", "core/training/training_progress.gd", "core/training/training_coach.gd"]:
		check(ResourceLoader.exists("res://scripts/" + path), "Missing production module " + path)
	if failures:
		quit(1)
		return
	var profiles = load("res://scripts/client/session/local_match_profiles.gd").new()
	var config: Dictionary = profiles.templates().solo_easy
	check(profiles.put_profile("Practice", config).ok, "Store valid configuration profile")
	var bad := config.duplicate()
	bad.count = 999
	check(not profiles.put_profile("Bad", bad).ok and profiles.profiles.size() == 1, "Reject invalid profile atomically")
	var path := "/tmp/tb250-profiles-%s.cfg" % OS.get_process_id()
	check(profiles.save_to(path) == OK, "Profile persistence")
	var restored = profiles.get_script().new()
	check(restored.load_from(path) == OK and restored.profiles.Practice == config, "Profile roundtrip")
	DirAccess.remove_absolute(path)
	var series = load("res://scripts/client/session/match_series.gd").new()
	check(series.start(3), "Best of three")
	check(series.record_result(1, 1) and not series.record_result(1, 1), "Series deduplicates result")
	check(series.record_result(2, 1) and series.completed, "Series clinched by two wins")
	check(not series.start(2),"Reject unsupported series length")
	series.start(5)
	check(series.record_result(10,0) and series.scores[1] == 0,"Draw does not award points")
	check(series.next_round(),"Draw permits next round")
	var history = load("res://scripts/core/training/attempt_history.gd").new()
	check(history.append({"event_id":"a","hit":true,"enemy_damage":10,"distance":2.0}), "Record attempt")
	check(not history.append({"event_id":"a","hit":true}), "Attempt dedupe")
	check(history.streak() == 1, "Hit streak")
	for index in 60: history.append({"event_id":"n"+str(index),"hit":index%2 == 0,"enemy_damage":index,"distance":float(60-index)})
	check(history.entries().size() == 50 and history.best().enemy_damage == 59,"Bounded history chooses best damage")
	var progress = load("res://scripts/core/training/training_progress.gd").new()
	check(progress.complete("movement") and not progress.complete("invented"), "Progress validates lessons")
	var progress_file := "/tmp/tb250-progress-model-%s.cfg" % OS.get_process_id()
	check(progress.save_to(progress_file) == OK,"Progress saved")
	var loaded_progress = progress.get_script().new()
	check(loaded_progress.load_from(progress_file) == OK and loaded_progress.is_complete("movement"),"Progress roundtrip")
	loaded_progress.reset()
	check(not loaded_progress.is_complete("movement"),"Progress reset")
	DirAccess.remove_absolute(progress_file)
	var training = load("res://scripts/core/training/training_session.gd").new()
	check(not training.begin("missing", {}).ok, "Invalid training start")
	var captions = load("res://scripts/client/ui/event_captions.gd").new()
	captions.enabled = true
	captions.consume([{"type":"TurnStarted"}],"1")
	captions.consume([{"type":"TurnStarted"}],"1")
	captions.tick(0.1)
	check(captions.pending.size() == 1 and "New turn" in captions.text,"Captions deduplicate event identities")
	captions.tick(4)
	check(captions.text.is_empty(),"Captions expire")
	captions.free()
	var status_script = load("res://scripts/client/ui/control_status.gd")
	check(status_script.describe({"bot":true}).reason == "Bot is planning","HUD explains bot guard")
	check(status_script.describe({}).can_control,"HUD clears stale restriction")
	var prefs = load("res://scripts/client/settings/client_settings.gd").new()
	prefs.update({"aim_mode":"toggle", "charge_mode":"click", "effects_volume":0.3,"reduced_motion":true})
	check(prefs.get("aim_mode") == "toggle" and prefs.get("reduced_motion") == true, "Accessibility settings update")
	var scene = load("res://scenes/debug/VoxelDebug.tscn").instantiate()
	root.add_child(scene)
	await process_frame
	scene.set_physics_process(false)
	check(scene.get("workflows") != null,"Scene integrates client workflows")
	if scene.get("workflows") != null:
		scene.workflows.progress_path = "/tmp/tb250-progress-%s.cfg" % OS.get_process_id()
		check(scene.start_local_match("two_islands",2,"training","solo","easy",2),"Human team configurable")
		check(scene.session.options.human_team == 2,"Existing options retain human team")
		var old_runner = scene.runner
		scene.workflows.begin_training("movement")
		check(scene.workflows.training.active and scene.runner != old_runner,"Training clones local match")
		scene.workflows.exit_training()
		check(scene.runner == old_runner,"Training returns original live runner")
		check(scene.start_local_match("two_islands",2,"training","hotseat","normal",1),"Local training fixture")
		var store = load("res://scripts/core/replay/session_store.gd")
		var snapshot: Dictionary = store.encode(scene.runner,scene.session.options,scene.player_velocities)
		check(snapshot.ok,"Training snapshot encodes")
		var command = load("res://scripts/core/turns/player_action_command.gd").new()
		var player = scene.runner.state.get_active_player()
		var enemy = scene.runner.state.players.filter(func(p): return p.team_id != player.team_id)[0]
		command.player_id = player.player_id
		command.weapon_id = 1
		command.shot_power = 1.0
		command.aim_direction = Vector3.RIGHT
		var damage_result := {"ok":true,"events":[{"type":"PlayerDamaged","player_id":enemy.player_id,"amount":40},{"type":"ShotResolved","position":[enemy.position.x,enemy.position.y,enemy.position.z]}]}
		for id in ["accuracy","wind","safe_fire","blind_accuracy"]:
			check(training.begin(id,snapshot.payload).ok and training.arm(),"Lesson starts: " + id)
			check(training.before_shot(snapshot.payload,command),"Attempt checkpoint: " + id)
			training.after_shot(command,damage_result)
			check(training.phase == "complete", "Real damage event evaluates " + id)
		training.begin("safe_fire",snapshot.payload)
		training.arm()
		training.before_shot(snapshot.payload,command)
		var unsafe := damage_result.duplicate(true)
		unsafe.events.append({"type":"PlayerDamaged","player_id":player.player_id,"amount":1})
		training.after_shot(command,unsafe)
		check(training.phase == "result" and training.summary().friendly_damage == 1,"Friendly fire prevents safe lesson completion")
		training.begin("accuracy",snapshot.payload)
		training.arm()
		training.before_shot(snapshot.payload,command,true)
		training.after_shot(command,damage_result)
		check(training.phase == "result" and training.summary().attempts == 0,"Demonstration does not award user progress")
		training.begin("movement",snapshot.payload)
		training.arm()
		training.observe_motion(player.position,Vector3.ZERO,true,false)
		check(training.phase == "armed","Stationary movement lesson not complete")
		training.observe_motion(player.position+Vector3.RIGHT*4,Vector3.RIGHT,true,false)
		check(training.phase == "complete","Movement requires actual displacement")
		training.begin("jump",snapshot.payload)
		training.arm()
		training.observe_motion(player.position,Vector3.UP,true,true)
		training.observe_motion(player.position+Vector3.UP,Vector3.UP,false,false)
		training.observe_motion(player.position,Vector3.ZERO,true,false)
		check(training.phase == "complete","Jump and landing complete lesson")
		training.begin("cancel_aim",snapshot.payload)
		training.arm()
		training.observe_intent("cancel")
		check(training.phase == "armed","Cancel alone insufficient")
		for intent in ["aim","charge","cancel"]: training.observe_intent(intent)
		check(training.phase == "complete","Aim charge cancel sequence")
		training.begin("power",snapshot.payload)
		training.arm()
		training.before_shot(snapshot.payload,command)
		training.after_shot(command,damage_result)
		training.arm()
		command.shot_power = 3.5
		training.before_shot(snapshot.payload,command)
		training.after_shot(command,damage_result)
		check(training.phase == "complete","Low and high power lesson")
		training.begin("weapons",snapshot.payload)
		for id in scene.runner.weapons:
			training.arm()
			command.weapon_id = id
			training.before_shot(snapshot.payload,command)
			training.after_shot(command,damage_result)
		check(training.phase == "complete","Weapons exercise uses available catalog")
		training.begin("streak",snapshot.payload)
		for index in 3:
			training.arm()
			training.before_shot(snapshot.payload,command)
			training.after_shot(command,damage_result)
		check(training.phase == "complete" and training.summary().attempts == 3,"Three hit challenge")
		training.begin("ammo_budget",snapshot.payload)
		var small_hit := damage_result.duplicate(true)
		small_hit.events[0].amount = 10
		for weapon in [1,2,3]:
			training.arm()
			command.weapon_id = weapon
			training.before_shot(snapshot.payload,command)
			training.after_shot(command,small_hit)
		check(training.phase == "complete","Ammo challenge counts distinct weapons and damage budget")
		var restore_result: Dictionary = training.retry_attempt()
		check(restore_result.ok and load("res://scripts/core/replay/match_replay.gd").state_hash(restore_result.runner) == load("res://scripts/core/replay/match_replay.gd").state_hash(scene.runner),"Retry restores exact pre-shot state")
		var before_time: float = training.elapsed_active
		training.tick(0.2,true)
		check(training.elapsed_active == before_time,"Paused training clock")
		training.tick(0.2,false)
		check(training.elapsed_active > before_time,"Active training clock")
		var autosave = load("res://scripts/client/session/local_autosave.gd").new("/tmp/tb250-autosave-%s" % OS.get_process_id())
		for index in 5:
			scene.runner.state.time_remaining = 40-index
			check(autosave.save(scene.runner,scene.session.options,scene.player_velocities).ok,"Autosave rotation")
		var latest: Dictionary = autosave.latest_valid()
		check(latest.ok and latest.runner.state.time_remaining == 36,"Latest rapid autosave selected")
		var remaining := []
		for slot in autosave.slot_paths():
			var loaded: Dictionary = store.load(slot)
			check(loaded.ok,"Autosave slot remains valid")
			remaining.append(loaded.runner.state.time_remaining)
		remaining.sort()
		check(remaining == [36.0,37.0,38.0],"Rotation retains last three rapid saves")
		var fresh_autosave = autosave.get_script().new(autosave.base_path)
		check(fresh_autosave.latest_valid().runner.state.time_remaining == 36,"Autosave rotation order survives restart")
		var newest := ""
		for slot in fresh_autosave.slot_paths():
			if fresh_autosave.sequence.get(slot.get_file(),0) == fresh_autosave.counter: newest = slot
		var corrupt := FileAccess.open(newest,FileAccess.WRITE)
		corrupt.store_string("invalid checkpoint")
		corrupt.close()
		var fallback: Dictionary = fresh_autosave.latest_valid()
		check(fallback.ok and fallback.skipped == 1 and fallback.runner.state.time_remaining == 37,"Autosave reports damaged newest slot and uses previous valid")
		for path_name in DirAccess.get_files_at(autosave.base_path): DirAccess.remove_absolute(autosave.base_path.path_join(path_name))
		DirAccess.remove_absolute(autosave.base_path)
		scene.preferences.aim_mode = "toggle"
		scene.preferences.charge_mode = "click"
		scene._close_overlays()
		scene._toggle_aim_intent(true)
		scene._toggle_aim_intent(false)
		check(scene.is_aiming,"Toggle aim remains after release")
		scene._charge_click_intent(true)
		scene._charge_click_intent(false)
		check(scene.is_charging_shot and not scene.projectile_in_flight,"Click charge first release does not fire")
		scene._cancel_aim()
		check(not scene.is_charging_shot and not scene.is_aiming,"Cancel clears accessibility input state")
		var hash_before: String = load("res://scripts/core/replay/match_replay.gd").state_hash(scene.runner)
		scene.request_restart()
		check(not scene.workflows.weapon_hud.visible,"HUD hidden immediately behind modal")
		check(scene.workflows.confirmation.visible,"Restart intent requires confirmation")
		scene.workflows.confirmation.hide()
		scene._refresh_menu_state()
		check(load("res://scripts/core/replay/match_replay.gd").state_hash(scene.runner) == hash_before,"Cancelled restart preserves match")
		scene.workflows.begin_training("movement")
		scene.workflows.training.observe_motion(scene.runner.state.get_active_player().position+Vector3.RIGHT*4,Vector3.RIGHT,true,false)
		scene.workflows.update(0.01)
		check(scene.workflows.training_panel.visible and scene.workflows.progress.is_complete("movement"),"Training completion shown and progress saved")
		scene.workflows.exit_training()
		DirAccess.remove_absolute(scene.workflows.progress_path)
		scene.preferences.hotseat_handoff = true
		scene.runner.advance([])
		scene.workflows.update(0.01)
		check(scene.workflows.handoff and scene.match_panels.handoff_panel.visible and not scene._can_control(),"Hotseat handoff pauses control")
		scene._close_overlays()
		check(scene.match_panels.handoff_panel.visible,"Global overlay close cannot hide pending handoff")
		scene.workflows.begin_training("movement")
		check(not scene.workflows.handoff and scene._can_control(),"Training temporarily suspends handoff")
		scene.workflows.exit_training()
		check(scene.workflows.handoff,"Return restores pending live handoff")
		scene.match_panels.handoff_ready.emit()
		check(not scene.workflows.handoff and not scene.menu_open,"Ready resumes hotseat")
		scene.preferences.hotseat_handoff = false
		scene._toggle_setup()
		scene.workflows.focus.open(scene.match_panels.setup_panel)
		var owner: Control = root.gui_get_focus_owner()
		check(owner != null and scene.match_panels.setup_panel.is_ancestor_of(owner),"Panel receives keyboard focus")
		check(not owner.focus_previous.is_empty(),"Panel focus traversal wraps")
		scene.workflows.series.start(3)
		var replacement: Dictionary = store.decode(snapshot.payload)
		scene._replace_local_runner(replacement.runner)
		scene.workflows.update(0.01)
		check(not scene.workflows.series.active,"Arbitrary checkpoint replacement resets local series")
	scene.free()
	print("Client250 tests: %d failures" % failures)
	quit(1 if failures else 0)
